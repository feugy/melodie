{
	"name": "web",
	"version": "3.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun -b run vite build",
		"build:storybook": "bun -b run storybook build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "bun run test --watch",
		"dev:storybook": "bun -b run storybook dev -p 6006",
		"start": "bun -b run vite dev --open",
		"test": "bun test --conditions=browser --conditions=svelte"
	},
	"exports": {
		".": "./build/handler.js"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.7.0",
		"@happy-dom/global-registrator": "^17.4.6",
		"@melodie/common": "workspace:*",
		"@skeletonlabs/skeleton": "3.1.3",
		"@skeletonlabs/skeleton-svelte": "^1.2.1",
		"@storybook/addon-essentials": "^8.6.12",
		"@storybook/addon-interactions": "^8.6.12",
		"@storybook/addon-links": "^8.6.12",
		"@storybook/addon-svelte-csf": "^5.0.0-next.29",
		"@storybook/addon-themes": "^8.6.12",
		"@storybook/addon-toolbars": "^8.6.12",
		"@storybook/blocks": "^8.6.12",
		"@storybook/svelte": "^8.6.12",
		"@storybook/sveltekit": "^8.6.12",
		"@storybook/test": "^8.6.12",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/enhanced-img": "^0.5.0",
		"@sveltejs/kit": "^2.20.8",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.5",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@testing-library/user-event": "^14.6.1",
		"@types/xxhashjs": "^0.2.4",
		"@unpic/core": "^1.0.1",
		"@unpic/svelte": "^1.0.0",
		"@vinejs/vine": "^3.0.1",
		"bun-bagel": "^1.2.0",
		"fake-indexeddb": "^6.0.0",
		"localforage": "^1.10.0",
		"lucide-svelte": "^0.507.0",
		"msw": "^2.7.5",
		"msw-storybook-addon": "^2.0.4",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"storybook": "^8.6.12",
		"svelte": "^5.28.2",
		"svelte-check": "^4.1.7",
		"svelte-intl-precompile": "^0.12.3",
		"tailwindcss": "^4.1.5",
		"ts-blank-space": "^0.6.1",
		"unpic": "^4.1.2",
		"vite": "^6.3.4",
		"yaml": "^2.7.1",
		"zod": "^3.24.3",
		"zod-validation-error": "^3.4.0"
	},
