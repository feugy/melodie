{
	"name": "web",
	"version": "3.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev --open",
		"dev:test": "vitest",
		"dev:storybook": "storybook dev -p 6006",
		"build": "pnpm build:vite && pnpm build:migrations",
		"build:assets": "pwa-assets-generator --preset minimal-2023 static/icon.svg",
		"build:migrations": "cp -R ../common/src/models/migrations .svelte-kit/output/server/chunks",
		"build:storybook": "storybook build",
		"build:vite": "vite build",
		"preview": "vite preview",
		"test": "pnpm dev:test --run"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.3.0",
		"@melodie/common": "workspace:*",
		"@skeletonlabs/skeleton": "3.0.0-next.9",
		"@skeletonlabs/skeleton-svelte": "1.0.0-next.13",
		"@storybook/addon-essentials": "^8.4.7",
		"@storybook/addon-interactions": "^8.4.7",
		"@storybook/addon-links": "^8.4.7",
		"@storybook/addon-svelte-csf": "5.0.0-next.21",
		"@storybook/addon-themes": "^8.4.7",
		"@storybook/addon-toolbars": "^8.4.7",
		"@storybook/blocks": "^8.4.7",
		"@storybook/svelte": "^8.4.7",
		"@storybook/sveltekit": "^8.4.7",
		"@storybook/test": "^8.4.7",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/adapter-vercel": "^5.5.2",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.13.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.6",
		"@testing-library/user-event": "^14.5.2",
		"@types/xxhashjs": "^0.2.4",
		"@unpic/core": "^0.1.0",
		"@unpic/svelte": "^0.0.57",
		"@vercel/analytics": "^1.4.1",
		"@vinejs/vine": "^3.0.0",
		"@vite-pwa/assets-generator": "^0.2.6",
		"@vite-pwa/sveltekit": "^0.6.6",
		"autoprefixer": "^10.4.20",
		"dotenv-flow": "^4.1.0",
		"jsdom": "^25.0.1",
		"localforage": "^1.10.0",
		"lucide-svelte": "^0.469.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"storybook": "^8.4.7",
		"svelte": "^5.15.0",
		"svelte-check": "^4.1.1",
		"svelte-intl-precompile": "^0.12.3",
		"tailwindcss": "^3.4.17",
		"tailwindcss-content-visibility": "^1.0.1",
		"unpic": "^3.22.0",
