{
	"name": "server",
	"description": "Server which watches local folders and host the Web UI",
	"version": "3.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"add-user": "NODE_ENV=test bun run ./scripts/add-user.ts",
		"build": "bun build --compile ./src/main.ts ./src/worker.ts --outfile=../../build/melodie --define Bun.env.NODE_ENV=\"'production'\"",
		"check": "tsc --noEmit",
		"dev": "bun test --watch",
		"refresh-certs": "NODE_ENV=test bun run ./scripts/refresh-certs.ts",
		"start": "bun --hot --cwd src main.ts -- -c ../../../build/.melodie",
		"test": "bun test"
	},
	"dependencies": {
		"@fastify/compress": "^8.0.1",
		"@fastify/cors": "^11.0.1",
		"@fastify/static": "^8.1.1",
		"@repeaterjs/repeater": "^3.0.6",
		"@vinejs/vine": "^3.0.1",
		"acme-client": "^5.4.0",
		"chokidar": "^4.0.3",
		"fastify": "^5.3.3",
		"ipx": "^3.0.3",
		"klaw": "^4.1.0",
		"mime-type": "^5.0.3",
		"ms": "3.0.0-canary.1",
		"music-metadata": "^11.2.2",
		"open": "^10.1.2",
		"ora": "^8.2.0",
		"public-ip": "^7.0.1",
		"sharp": "0.33.5",
		"web": "workspace:*"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.8.0",
		"@melodie/common": "workspace:^",
		"@types/klaw": "^3.0.6",
		"@types/ms": "^2.1.0"
	},
	"engines": {
		"bun": ">=1.2"
	}
}
